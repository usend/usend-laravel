{
  "name": "usend/laravel",
  "description": "Official Laravel package for usend: a mail transport and a ready-made client for the usend email API.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://usend.et",
  "keywords": ["laravel", "email", "usend", "mail", "transactional"],
  "support": {
    "docs": "https://usend.et/docs/quickstarts/laravel",
    "source": "https://github.com/usend/usend-laravel"
  },
  "require": {
    "php": ">=8.1",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "illuminate/mail": "^10.0|^11.0|^12.0",
    "symfony/mailer": "^6.2|^7.0",
    "usend/usend": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Usend\\Laravel\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": ["Usend\\Laravel\\UsendServiceProvider"]
    }
  }
}
